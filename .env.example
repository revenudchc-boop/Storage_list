# انسخ هذا الملف باسم .env ثم عدّل القيم (لا ترفع .env إلى GitHub)
PORT=3000

# مسار الأرشيف ومجلد التطبيق على الـ NAS
ARCHIVE_PATH=\\10.0.182.128\database\archive
APP_PATH=\\10.0.182.128\database\app

# بيانات دخول الـ NAS (اتركها فارغة إن لم تكن مطلوبة)
NAS_USER=
NAS_PASSWORD=

# سر توقيع الجلسات. إن تُرك فارغاً يُولَّد تلقائياً في data/.secret
SESSION_SECRET=
SESSION_HOURS=8

# المصدر: ملف users.json بجانب الخادم. لمزامنته من GitHub (نفس مصدر لوحة إدارة المستخدمين) فعّل السطر التالي:
# USERS_URL=https://raw.githubusercontent.com/markingdchc/marking.dchc/main/users.json

# أصول إضافية مسموح لها بالاتصال (مثل GitHub Pages). شبكتك الداخلية مسموحة تلقائياً.
# ALLOWED_ORIGINS=https://markingdchc.github.io,https://revenudchc-boop.github.io
ALLOW_PRIVATE_NETWORK_ORIGINS=true

MAX_FILE_SIZE_MB=50
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# لتفعيل HTTPS ضع مسار الشهادة والمفتاح
# TLS_CERT=C:\certs\server.crt
# TLS_KEY=C:\certs\server.key
